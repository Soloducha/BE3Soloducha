{
  "name": "shipnow-base",
  "version": "1.0.0",
  "description": "ShipNow API - Base para refactorizacion a arquitectura por capas",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:verbose": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --verbose",
    "test:mocha": "mocha",
    "test:mocha:verbose": "mocha --reporter spec"
  },
  "keywords": [
    "backend",
    "api",
    "logistica",
    "coderhouse"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "chai": "^6.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mocha": "^8.1.3",
    "mongoose": "^8.12.1",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
